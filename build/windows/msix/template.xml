<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="whiskerlink"
        Arguments=""
        InstallLocation="C:\Program Files\WhiskerLink">
    </Installer>
    <PackageInformation
        PackageName="WhiskerLink"
        PackageDisplayName="WhiskerLink"
        PublisherName="CN=David Carliez"
        PublisherDisplayName="David Carliez"
        Version="0.1.0.0"
        PackageDescription="Private paths for files and services, powered by Tailcat">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.davidcarliez.whiskerlink"
                Description="Private paths for files and services, powered by Tailcat"
                DisplayName="WhiskerLink"
                ExecutableName="whiskerlink"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WhiskerLink</DisplayName>
            <PublisherDisplayName>David Carliez</PublisherDisplayName>
            <Description>Private paths for files and services, powered by Tailcat</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="whiskerlink.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
